# Copy to .env and fill in the providers you want. Every key below has a free tier.
# Tempo only routes to providers whose key (or base URL) is set.

# Keep comments on their own lines: "KEY=   # note" would set the key to "# note".

# https://console.groq.com/keys
GROQ_API_KEY=
# https://cloud.cerebras.ai
# Off by default (trial, needs a payment method); also set TEMPO_ENABLE_PROVIDERS=cerebras.
CEREBRAS_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://dash.cloudflare.com/profile/api-tokens (Workers AI). The account id is not a secret.
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Cohere: each user adds their own trial key (tempo keys add cohere); a key here is ignored.
# https://console.mistral.ai/api-keys (free plan; turn off training on your data in the console)
MISTRAL_API_KEY=
# Providers whose console setting "train on my data" you have turned off (e.g. mistral).
# TEMPO_OPTED_OUT=
# https://build.nvidia.com (trial terms: testing and evaluation only). Off unless you also set
# TEMPO_ENABLE_PROVIDERS=nvidia (comma-separated, e.g. nvidia,cerebras).
NVIDIA_API_KEY=
# TEMPO_ENABLE_PROVIDERS=
# OpenCode Zen: off unless TEMPO_ENABLE_PROVIDERS includes opencode; then each user adds their
# own key (tempo keys add opencode); a key here is ignored.

# Local models through Ollama (https://ollama.com). Installed models are discovered automatically.
# OLLAMA_API_BASE=http://localhost:11434

# The keys above are yours (the owner's): other users of this server use only their own keys.
# Set to 1 to let every user of this server use them too.
# TEMPO_SHARE_SERVER_KEYS=

# Optional: require "Authorization: Bearer <key>" on the API and web app.
# TEMPO_API_KEY=

# Optional: offline demo models that need no keys (one of them always fails, to show fallback).
# TEMPO_ENABLE_MOCK=1

# Optional tuning.
# TEMPO_REQUEST_TIMEOUT=60
# TEMPO_MAX_ATTEMPTS=4
# TEMPO_MODELS_FILE=/path/to/your/models.yaml

# Staged engine: budgets per question (each question can lower or raise them).
# TEMPO_MAX_STAGES=5            # up to 50; use 20+ for big multi-part jobs
# TEMPO_TIME_BUDGET=60          # seconds
# TEMPO_QUOTA_BUDGET=12         # free provider requests (local models are free)
# TEMPO_MAX_PARALLEL=3          # models per parallel stage
# TEMPO_JUDGE=1                 # judge answers with a model from another family

# Storage: question logs for tuning, quota counters, users, encrypted provider keys.
# TEMPO_DATA_DIR=~/.tempo       # "memory" keeps nothing on disk
# TEMPO_LOG=1
# Key-vault secret; without it, a private secret.key file in the data dir is used.
# TEMPO_SECRET_KEY=

# Laya, the fast decision-maker (pip install -e ".[laya]"). Runs on CPU. Shadow mode until you
# hand it decisions; shadow predictions run in the background and never slow an answer down.
# TEMPO_LAYA=auto               # auto | on | off
# TEMPO_LAYA_BACKEND=torch      # torch | onnx | onnx-int8 (INT8 changes answers: docs/LAYA_CPU.md)
# TEMPO_LAYA_CHECKPOINT=english # stock checkpoint: english | multilingual
# TEMPO_LAYA_THREADS=4          # CPU threads (default: up to 4 cores)
# A checkpoint fine-tuned on `tempo export-laya` data (a folder or Hub repo):
# TEMPO_LAYA_MODEL=
# Per-decision takeover, e.g. "should_stop=auto, next_model=auto" or "all=auto":
# TEMPO_LAYA_TAKEOVER=
# How long an answer waits for a taken-over decision; "auto" measures it on this machine.
# TEMPO_LAYA_TIMEOUT_MS=auto
# TEMPO_LAYA_MIN_CONFIDENCE=0.6
# TEMPO_LAYA_DEVICE=cpu         # device for the torch backend; Tempo only ever needs a CPU

# Embedding classifier and semantic cache (pip install -e ".[embeddings]").
# TEMPO_EMBEDDINGS=auto         # auto | off
# TEMPO_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# TEMPO_CACHE=1
# TEMPO_CACHE_TTL=86400

# Seconds between provider model-list syncs (0 = off).
# TEMPO_SYNC_INTERVAL=21600
