# Copy to .env and fill in the providers you want. Every key below has a free tier.
# Tempo only routes to providers whose key (or base URL) is set.

GROQ_API_KEY=            # https://console.groq.com/keys
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=      # https://openrouter.ai/keys

# Local models through Ollama (https://ollama.com). Installed models are discovered automatically.
# OLLAMA_API_BASE=http://localhost:11434

# Optional: require "Authorization: Bearer <key>" on the API and web app.
# TEMPO_API_KEY=

# Optional: offline demo models that need no keys (one of them always fails, to show fallback).
# TEMPO_ENABLE_MOCK=1

# Optional tuning.
# TEMPO_REQUEST_TIMEOUT=60
# TEMPO_MAX_ATTEMPTS=4
# TEMPO_MODELS_FILE=/path/to/your/models.yaml
